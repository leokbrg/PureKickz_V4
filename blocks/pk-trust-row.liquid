{%- comment -%}
  PUREKICKZ Trust-Zeile direkt unter dem Kaufbutton: kurze Versprechen + Zahlungsarten-Icons.
{%- endcomment -%}

<div class="pk-trust-row" {{ block.shopify_attributes }}>
  <ul class="pk-trust-row__list">
    {%- for i in (1..3) -%}
      {%- liquid
        assign text_key = 'text_' | append: i
        assign icon_key = 'icon_' | append: i
        assign text = block.settings[text_key]
      -%}
      {%- if text != blank -%}
        <li class="pk-trust-row__item">
          {%- render 'pk-icon', name: block.settings[icon_key], class: 'pk-trust-row__icon' -%}
          <span>{{ text }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  {%- if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
    <ul class="pk-trust-row__payments" aria-label="Zahlungsarten">
      {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag: class: 'pk-trust-row__payment' }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .pk-trust-row {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--pk-line);
  }

  .pk-trust-row__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .pk-trust-row__item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    color: #55554f;
  }

  .pk-trust-row__icon {
    flex: none;
    width: 17px;
    height: 17px;
    color: var(--pk-ink);
  }

  .pk-trust-row__payments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pk-trust-row__payment {
    display: block;
    width: 38px;
    height: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PK Trust unter Button",
  "settings": [
    {
      "type": "select",
      "id": "icon_1",
      "label": "Icon 1",
      "options": [
        { "value": "truck", "label": "Versand" },
        { "value": "return", "label": "Rückgabe" },
        { "value": "lock", "label": "Sicher bezahlen" },
        { "value": "clock", "label": "Zeit" },
        { "value": "box", "label": "Paket" },
        { "value": "check", "label": "Haken" }
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Text 1",
      "default": "Versand aus Deutschland"
    },
    {
      "type": "select",
      "id": "icon_2",
      "label": "Icon 2",
      "options": [
        { "value": "truck", "label": "Versand" },
        { "value": "return", "label": "Rückgabe" },
        { "value": "lock", "label": "Sicher bezahlen" },
        { "value": "clock", "label": "Zeit" },
        { "value": "box", "label": "Paket" },
        { "value": "check", "label": "Haken" }
      ],
      "default": "return"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text 2",
      "default": "14 Tage Widerruf, Rücksendung kostenlos"
    },
    {
      "type": "select",
      "id": "icon_3",
      "label": "Icon 3",
      "options": [
        { "value": "truck", "label": "Versand" },
        { "value": "return", "label": "Rückgabe" },
        { "value": "lock", "label": "Sicher bezahlen" },
        { "value": "clock", "label": "Zeit" },
        { "value": "box", "label": "Paket" },
        { "value": "check", "label": "Haken" }
      ],
      "default": "lock"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text 3",
      "default": "Sichere Bezahlung"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Zahlungsarten-Icons zeigen",
      "info": "Automatisch aus den aktiven Zahlungsarten in Shopify.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "PK Trust unter Button"
    }
  ]
}
{% endschema %}
