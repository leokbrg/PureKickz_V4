{%- comment -%}
  PUREKICKZ Hero: Headline, Kurztext, Preis live aus dem Produkt, Kaufbutton.
  Bild-Stile:
  - photo:   Foto ist der Hintergrund der ganzen Section (randlos, Text liegt auf dem Studiohintergrund)
  - cutout:  freigestelltes Produkt steht auf der Seite
  - framed:  Foto im Rahmen neben dem Text
  Ohne eigene Bilder wird das Hauptbild des gewählten Produkts gezeigt.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
  assign style = section.settings.image_style

  assign image_desktop = section.settings.image_desktop
  if image_desktop == blank and product != blank
    assign image_desktop = product.featured_media.preview_image
  endif
  assign image_mobile = section.settings.image_mobile | default: image_desktop
  assign image_tablet = section.settings.image_tablet

  assign button_link = section.settings.button_link
  if button_link == blank and product != blank
    assign button_link = product.url
  endif

  assign desktop_srcset = ''
  if image_desktop != blank
    for w in (6..26)
      assign px = w | times: 100
      if px <= image_desktop.width
        assign entry = image_desktop | image_url: width: px | append: ' ' | append: px | append: 'w, '
        assign desktop_srcset = desktop_srcset | append: entry
      endif
    endfor
    assign desktop_srcset = desktop_srcset | strip | remove_last: ','
  endif

  assign tablet_srcset = ''
  if style == 'photo' and image_tablet != blank
    for w in (8..22)
      assign px = w | times: 100
      if px <= image_tablet.width
        assign entry = image_tablet | image_url: width: px | append: ' ' | append: px | append: 'w, '
        assign tablet_srcset = tablet_srcset | append: entry
      endif
    endfor
    assign tablet_srcset = tablet_srcset | strip | remove_last: ','
  endif

  if style == 'photo'
    assign desktop_sizes = '100vw'
    assign desktop_media = '(min-width: 990px)'
  else
    assign desktop_sizes = '(min-width: 990px) 58vw, 100vw'
    assign desktop_media = '(min-width: 750px)'
  endif
-%}

{%- capture picture -%}
  {%- if image_desktop != blank -%}
    {%- comment -%} Ein <picture>: das Handy lädt nur das Hochformat, der Desktop nur das Querformat {%- endcomment -%}
    <picture>
      <source media="{{ desktop_media }}" srcset="{{ desktop_srcset }}" sizes="{{ desktop_sizes }}">
      {%- if tablet_srcset != blank -%}
        <source media="(min-width: 750px)" srcset="{{ tablet_srcset }}" sizes="100vw">
      {%- endif -%}
      {{
        image_mobile
        | image_url: width: 1440
        | image_tag:
          widths: '400, 600, 800, 1100, 1440',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'pk-hero__img'
      }}
    </picture>
  {%- else -%}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'pk-hero__img' }}
  {%- endif -%}
{%- endcapture -%}

<div
  class="pk-hero pk-hero--{{ style }} pk-hero--image-{{ section.settings.image_position }}{% if tablet_srcset != blank %} pk-hero--has-tablet{% endif %}"
  style="--pk-hero-bg: {{ section.settings.background_color }}; --pk-pad-top: {{ section.settings.padding_top }}px; --pk-pad-bottom: {{ section.settings.padding_bottom }}px; --pk-hero-text-start: {{ section.settings.mobile_text_start }};"
>
  <div class="pk-hero__stage">
  {%- if style == 'photo' -%}
    <div class="pk-hero__bg">{{ picture }}</div>
  {%- endif -%}

  <div class="pk-hero__inner">
    <div class="pk-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pk-hero__eyebrow pk-hero__rise" style="--i: 0">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="pk-hero__heading pk-hero__rise" style="--i: 1">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="pk-hero__lead pk-hero__rise" style="--i: 2">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- comment -%} Kaufbereich bewusst ohne Animation: sofort sichtbar und klickbar {%- endcomment -%}
      <div class="pk-hero__buy">
        {%- if product != blank and section.settings.show_price -%}
          <p class="pk-hero__price">
            <span class="pk-hero__price-value">{{ variant.price | money }}</span>
            <span class="pk-hero__price-note">
              {%- if cart.taxes_included -%}inkl. MwSt.{%- else -%}zzgl. MwSt.{%- endif -%}
              {%- if shop.shipping_policy.url != blank -%}
                , zzgl. <a href="{{ shop.shipping_policy.url }}">Versand</a>
              {%- endif -%}
            </span>
          </p>
        {%- endif -%}

        <div class="pk-hero__buttons">
          {%- if section.settings.button_label != blank and button_link != blank -%}
            <a class="button pk-hero__button" href="{{ button_link }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
            <a class="button-secondary pk-hero__button" href="{{ section.settings.button2_link }}">
              {{- section.settings.button2_label -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- unless style == 'photo' -%}
      <div class="pk-hero__media">
        <div class="pk-hero__frame">
          <span class="pk-hero__glow" aria-hidden="true"></span>
          {{ picture }}
          <span class="pk-hero__shadow" aria-hidden="true"></span>
        </div>
      </div>
    {%- endunless -%}
  </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="pk-hero__trust" data-pk-stagger>
      {%- for block in section.blocks -%}
        <li class="pk-hero__trust-item" data-pk-reveal {{ block.shopify_attributes }}>
          {%- capture trust_inner -%}
            {%- render 'pk-icon', name: block.settings.icon, class: 'pk-hero__trust-icon' -%}
            <span class="pk-hero__trust-text">
              <span class="pk-hero__trust-title">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}
                <span class="pk-hero__trust-sub">{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a class="pk-hero__trust-link" href="{{ block.settings.link }}">{{ trust_inner }}</a>
          {%- else -%}
            <div class="pk-hero__trust-link">{{ trust_inner }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .pk-hero {
    position: relative;
    overflow-x: clip;
    background: var(--pk-hero-bg, #fff);
    padding-block: calc(var(--pk-pad-top) * 0.6) calc(var(--pk-pad-bottom) * 0.6);
  }

  @media screen and (min-width: 990px) {
    .pk-hero {
      padding-block: var(--pk-pad-top) var(--pk-pad-bottom);
    }
  }

  .pk-hero__inner {
    position: relative;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    display: grid;
    gap: 28px;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .pk-hero__inner {
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
      gap: clamp(40px, 5vw, 80px);
    }

    .pk-hero--image-left .pk-hero__media {
      order: -1;
    }
  }

  .pk-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }

  .pk-hero__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--pk-magenta);
  }

  .pk-hero__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(2.5rem, 8.6vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
    max-width: 11ch;
    color: var(--pk-ink);
  }

  .pk-hero__heading em {
    font-style: normal;
    color: var(--pk-magenta);
  }

  .pk-hero__lead {
    max-width: 46ch;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.55;
    color: #4a4a45;
  }

  .pk-hero__lead p {
    margin: 0;
  }

  .pk-hero__buy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 4px;
  }

  .pk-hero__price {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
  }

  .pk-hero__price-value {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .pk-hero__price-note {
    font-size: 0.8125rem;
    color: rgba(25, 25, 23, 0.72);
  }

  .pk-hero__price-note a {
    color: inherit;
    text-underline-offset: 2px;
  }

  .pk-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pk-hero__button {
    min-height: 54px;
    padding-inline: 32px;
    font-size: 1rem;
  }

  @media screen and (max-width: 749px) {
    .pk-hero__buttons {
      width: 100%;
    }

    .pk-hero__button {
      flex: 1 1 100%;
    }
  }

  .pk-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ——— Stil „photo“: Foto ist die Fläche, Text liegt auf dem Studiohintergrund ——— */
  .pk-hero--photo {
    padding: 0;
    background: var(--pk-hero-bg, var(--pk-grey));
  }

  .pk-hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .pk-hero__bg picture {
    display: contents;
  }

  /* Handy: Foto in natürlicher Größe oben, darunter läuft der Boden weich in die Fläche aus */
  .pk-hero--photo .pk-hero__bg {
    bottom: auto;
  }

  .pk-hero--photo .pk-hero__img {
    height: auto;
  }

  .pk-hero--photo .pk-hero__bg::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 38%;
    background: linear-gradient(to bottom, transparent, var(--pk-hero-bg));
    pointer-events: none;
  }

  /* Handy/Tablet: Text beginnt unter dem Produkt, auf dem hellen Boden des Fotos */
  .pk-hero--photo .pk-hero__inner {
    grid-template-columns: minmax(0, 1fr);
    padding-top: calc(var(--pk-hero-text-start) * 1vw);
    padding-bottom: 40px;
  }

  /* Tablet: Produkt mittig oben (breite Studiofassung), Text zentriert darunter */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .pk-hero--photo.pk-hero--has-tablet .pk-hero__inner {
      padding-top: calc(var(--pk-hero-text-start) * 0.62vw);
      padding-bottom: 64px;
      justify-items: center;
      text-align: center;
    }

    .pk-hero--photo.pk-hero--has-tablet .pk-hero__text,
    .pk-hero--photo.pk-hero--has-tablet .pk-hero__price,
    .pk-hero--photo.pk-hero--has-tablet .pk-hero__buttons {
      align-items: center;
      justify-content: center;
    }

    .pk-hero--photo.pk-hero--has-tablet .pk-hero__heading {
      max-width: 14ch;
    }
  }

  @media screen and (min-width: 990px) {
    .pk-hero--photo .pk-hero__bg {
      bottom: 0;
    }

    .pk-hero--photo .pk-hero__img {
      height: 100%;
      object-position: right bottom;
    }

    .pk-hero--photo .pk-hero__lead {
      max-width: 38ch;
    }

    .pk-hero--photo .pk-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: clamp(540px, 42vw, 820px);
      padding-block: var(--pk-pad-top) var(--pk-pad-bottom);
    }
  }

  /*
   * Ab 990 px: Schrift und Abstände wachsen stufenlos mit der Breite. Dadurch bleibt die Section so niedrig,
   * dass das Foto nicht vergrößert wird und das Produkt immer rechts neben dem Text steht.
   */
  @media screen and (min-width: 990px) {
    .pk-hero--photo .pk-hero__heading {
      font-size: clamp(3rem, 4.4vw, 4.8rem);
    }

    .pk-hero--photo .pk-hero__lead {
      max-width: 34ch;
      font-size: clamp(1rem, 1.15vw, 1.125rem);
    }

    .pk-hero--photo .pk-hero__text {
      gap: clamp(14px, 1.4vw, 20px);
    }

    .pk-hero--photo .pk-hero__inner {
      padding-block: clamp(48px, 5vw, 80px);
    }
  }

  @media screen and (min-width: 990px) and (max-width: 1199px) {
    .pk-hero--photo .pk-hero__inner {
      min-height: 0;
    }

    .pk-hero--photo .pk-hero__lead {
      max-width: 30ch;
    }
  }

  /* ——— Versprechen im Hero: auf dem verlängerten Studioboden, nicht über dem Produkt ——— */
  .pk-hero__stage {
    position: relative;
  }

  .pk-hero__trust {
    position: relative;
    list-style: none;
    margin: 0 auto;
    max-width: var(--page-width);
    padding: 4px var(--page-margin) 28px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 16px;
  }

  .pk-hero__trust-item {
    min-width: 0;
    display: flex;
  }

  .pk-hero__trust-link {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--pk-ink);
    text-decoration: none;
  }

  .pk-hero__trust-icon {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    transition: transform 0.4s var(--pk-ease), color 0.2s;
  }

  a.pk-hero__trust-link:hover .pk-hero__trust-icon {
    color: var(--pk-magenta);
    transform: translateY(-2px);
  }

  .pk-hero__trust-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .pk-hero__trust-title {
    font-family: var(--font-subheading--family);
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1.25;
  }

  .pk-hero__trust-sub {
    font-size: 0.75rem;
    line-height: 1.35;
    color: rgba(25, 25, 23, 0.72);
  }

  @media screen and (min-width: 990px) {
    .pk-hero__trust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      padding-block: 22px 30px;
    }

    .pk-hero__trust-item + .pk-hero__trust-item .pk-hero__trust-link {
      padding-left: 24px;
      border-left: 1px solid rgba(25, 25, 23, 0.12);
    }

    .pk-hero__trust-link {
      align-items: center;
      gap: 14px;
      padding-right: 16px;
    }

    .pk-hero__trust-icon {
      width: 24px;
      height: 24px;
      margin-top: 0;
    }

    .pk-hero__trust-title {
      font-size: 0.875rem;
    }

    .pk-hero__trust-sub {
      font-size: 0.78rem;
    }

    /* Foto läuft unten weich in den Studioboden aus, auf dem die Versprechen stehen */
    .pk-hero--photo .pk-hero__bg::after {
      display: block;
      height: 8%;
    }
  }

  /* ——— Stil „framed“: Foto im Rahmen ——— */
  .pk-hero__media {
    min-width: 0;
  }

  .pk-hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: var(--pk-grey);
    aspect-ratio: 3 / 4;
  }

  @media screen and (min-width: 750px) {
    .pk-hero__frame {
      aspect-ratio: 3 / 2;
    }
  }

  .pk-hero__frame picture {
    display: contents;
  }

  .pk-hero__glow,
  .pk-hero__shadow {
    display: none;
  }

  /* ——— Stil „cutout“: freigestelltes Produkt auf der Seite ——— */
  .pk-hero--cutout .pk-hero__frame {
    aspect-ratio: auto;
    overflow: visible;
    border-radius: 0;
    background: none;
    isolation: isolate;
  }

  .pk-hero--cutout .pk-hero__img {
    position: relative;
    z-index: 1;
    height: auto;
    object-fit: contain;
  }

  .pk-hero--cutout .pk-hero__glow {
    display: block;
    position: absolute;
    z-index: -1;
    inset: -8% -10% -4%;
    background: radial-gradient(closest-side, var(--pk-grey) 0%, rgba(232, 232, 230, 0.55) 55%, rgba(232, 232, 230, 0) 100%);
  }

  .pk-hero--cutout .pk-hero__shadow {
    display: block;
    position: absolute;
    z-index: 0;
    left: 8%;
    right: 6%;
    bottom: -2%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(25, 25, 23, 0.28), rgba(25, 25, 23, 0));
    filter: blur(6px);
  }

  /*
   * Bewegung (reines CSS, kein Aufblitzen): Text steigt gestaffelt auf, das Bild stellt sich
   * ruhig ein, am Desktop leichte Tiefe beim Scrollen. Kaufbereich bleibt immer sofort sichtbar.
   */
  @media (prefers-reduced-motion: no-preference) {
    .pk-hero__rise {
      animation: pk-hero-rise 0.8s var(--pk-ease) both;
      animation-delay: calc(var(--i, 0) * 90ms);
    }

    @keyframes pk-hero-rise {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
    }

    .pk-hero__img {
      animation: pk-hero-settle 1.4s var(--pk-ease) both;
    }

    @keyframes pk-hero-settle {
      from {
        opacity: 0;
        transform: scale(1.05);
      }
    }

    .pk-hero--cutout .pk-hero__img {
      animation-name: pk-hero-land;
    }

    .pk-hero--cutout .pk-hero__shadow {
      animation: pk-hero-shadow 1.1s var(--pk-ease) both;
    }

    @keyframes pk-hero-land {
      from {
        opacity: 0;
        transform: translateY(-28px);
      }
    }

    @keyframes pk-hero-shadow {
      from {
        opacity: 0;
        transform: scaleX(0.6);
      }
    }

    /* Tiefe beim Scrollen: das Bild bewegt sich etwas langsamer als die Seite */
    @supports (animation-timeline: view()) {
      @media screen and (min-width: 990px) {
        .pk-hero--cutout .pk-hero__media,
        .pk-hero--framed .pk-hero__frame {
          animation: pk-hero-drift linear both;
          animation-timeline: view();
          animation-range: exit 0% exit 100%;
        }

        @keyframes pk-hero-drift {
          to {
            transform: translateY(10%);
          }
        }
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PK Hero",
  "tag": "section",
  "class": "pk-section pk-section--hero",
  "settings": [
    {
      "type": "header",
      "content": "Produkt"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produkt",
      "info": "Preis und Button-Ziel kommen aus diesem Produkt. Ohne eigenes Bild wird sein Hauptbild gezeigt."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Preis anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Überzeile",
      "default": "PUREKICKZ ONE"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "info": "Kursiv gesetzter Text erscheint in Magenta.",
      "default": "Du führst. Der Rest <em>dreht sich.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Kurztext",
      "default": "<p>Der elektrische Sneaker Cleaner mit Motor und drei Aufsätzen. Du setzt ihn auf, die Bewegung macht das Gerät.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Haupt-Button",
      "default": "Jetzt kaufen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Haupt-Button Link",
      "info": "Leer lassen: führt zum gewählten Produkt."
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Zweiter Button",
      "default": "So funktioniert's"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Zweiter Button Link"
    },
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Bild-Stil",
      "options": [
        { "value": "photo", "label": "Foto als Hintergrund (randlos)" },
        { "value": "cutout", "label": "Freigestellt" },
        { "value": "framed", "label": "Foto im Rahmen" }
      ],
      "default": "photo"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Bild Desktop",
      "info": "Foto als Hintergrund: hero-studio-weit.jpg (Produkt rechts, ruhiger Raum links)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Bild Handy",
      "info": "Foto als Hintergrund: hero-studio-hoch.jpg (Produkt oben, Boden unten)"
    },
    {
      "type": "image_picker",
      "id": "image_tablet",
      "label": "Bild Tablet (nur Foto als Hintergrund)",
      "info": "hero-studio-tablet.jpg: Produkt mittig oben, viel Studioraum. Leer lassen: Handy-Bild."
    },
    {
      "type": "range",
      "id": "mobile_text_start",
      "label": "Handy: Text beginnt bei",
      "info": "Abstand von oben in % der Bildschirmbreite, damit der Text unter dem Produkt steht.",
      "min": 40,
      "max": 140,
      "step": 2,
      "unit": "%",
      "default": 70
    },
    {
