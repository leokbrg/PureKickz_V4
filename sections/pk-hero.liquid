{%- comment -%}
  PUREKICKZ Hero: Headline, Kurztext, Preis live aus dem Produkt, Kaufbutton, gerahmtes Bild.
  Ohne eigene Bilder wird das Hauptbild des gewählten Produkts gezeigt.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant

  assign image_desktop = section.settings.image_desktop
  if image_desktop == blank and product != blank
    assign image_desktop = product.featured_media.preview_image
  endif
  assign image_mobile = section.settings.image_mobile | default: image_desktop

  assign button_link = section.settings.button_link
  if button_link == blank and product != blank
    assign button_link = product.url
  endif
-%}

<div
  class="pk-hero pk-hero--image-{{ section.settings.image_position }} pk-hero--{{ section.settings.image_style }}"
  style="--pk-hero-bg: {{ section.settings.background_color }}; --pk-pad-top: {{ section.settings.padding_top }}px; --pk-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="pk-hero__inner">
    <div class="pk-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pk-hero__eyebrow pk-hero__rise" style="--i: 0">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="pk-hero__heading pk-hero__rise" style="--i: 1">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="pk-hero__lead pk-hero__rise" style="--i: 2">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- comment -%} Kaufbereich bewusst ohne Einblend-Animation: sofort sichtbar und klickbar {%- endcomment -%}
      <div class="pk-hero__buy">
        {%- if product != blank and section.settings.show_price -%}
          <p class="pk-hero__price">
            <span class="pk-hero__price-value">{{ variant.price | money }}</span>
            <span class="pk-hero__price-note">
              {%- if cart.taxes_included -%}inkl. MwSt.{%- else -%}zzgl. MwSt.{%- endif -%}
              {%- if shop.shipping_policy.url != blank -%}
                , zzgl. <a href="{{ shop.shipping_policy.url }}">Versand</a>
              {%- endif -%}
            </span>
          </p>
        {%- endif -%}

        <div class="pk-hero__buttons">
          {%- if section.settings.button_label != blank and button_link != blank -%}
            <a class="button pk-hero__button" href="{{ button_link }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
            <a class="button-secondary pk-hero__button" href="{{ section.settings.button2_link }}">
              {{- section.settings.button2_label -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="pk-hero__media">
      <div class="pk-hero__frame">
        <span class="pk-hero__glow" aria-hidden="true"></span>
        {%- if image_desktop != blank -%}
          {%- comment -%} Ein <picture>: das Handy lädt nur das Hochformat, der Desktop nur das Querformat {%- endcomment -%}
          {%- liquid
            assign desktop_srcset = ''
            for w in (6..16)
              assign px = w | times: 100
              if px <= image_desktop.width
                assign entry = image_desktop | image_url: width: px | append: ' ' | append: px | append: 'w, '
                assign desktop_srcset = desktop_srcset | append: entry
              endif
            endfor
            assign desktop_srcset = desktop_srcset | strip | remove_last: ','
          -%}
          <picture>
            <source media="(min-width: 750px)" srcset="{{ desktop_srcset }}" sizes="(min-width: 990px) 58vw, 100vw">
            {{
              image_mobile
              | image_url: width: 1100
              | image_tag:
                widths: '400, 600, 800, 1100',
                sizes: '100vw',
                loading: 'eager',
                fetchpriority: 'high',
                class: 'pk-hero__img'
            }}
          </picture>
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'pk-hero__img' }}
        {%- endif -%}
        <span class="pk-hero__shadow" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .pk-hero {
    overflow-x: clip;
    background: var(--pk-hero-bg, #fff);
    padding-block: calc(var(--pk-pad-top) * 0.6) calc(var(--pk-pad-bottom) * 0.6);
  }

  @media screen and (min-width: 990px) {
    .pk-hero {
      padding-block: var(--pk-pad-top) var(--pk-pad-bottom);
    }
  }

  .pk-hero__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    display: grid;
    gap: 28px;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .pk-hero__inner {
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
      gap: clamp(40px, 5vw, 80px);
    }

    .pk-hero--image-left .pk-hero__media {
      order: -1;
    }
  }

  .pk-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }

  .pk-hero__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--pk-magenta);
  }

  .pk-hero__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(2.6rem, 9vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
    max-width: 11ch;
    color: var(--pk-ink);
  }

  .pk-hero__heading em {
    font-style: normal;
    color: var(--pk-magenta);
  }

  .pk-hero__lead {
    max-width: 46ch;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.55;
    color: #55554f;
  }

  .pk-hero__lead p {
    margin: 0;
  }

  .pk-hero__buy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 4px;
  }

  .pk-hero__price {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
  }

  .pk-hero__price-value {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .pk-hero__price-note {
    font-size: 0.8125rem;
    color: var(--pk-muted);
  }

  .pk-hero__price-note a {
    color: inherit;
    text-underline-offset: 2px;
  }

  .pk-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pk-hero__button {
    min-height: 54px;
    padding-inline: 32px;
    font-size: 1rem;
  }

  @media screen and (max-width: 749px) {
    .pk-hero__buttons {
      width: 100%;
    }

    .pk-hero__button {
      flex: 1 1 100%;
    }
  }

  .pk-hero__media {
    min-width: 0;
  }

  .pk-hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: var(--pk-grey);
    aspect-ratio: 3 / 4;
  }

  @media screen and (min-width: 750px) {
    .pk-hero__frame {
      aspect-ratio: 3 / 2;
    }
  }

  .pk-hero__frame picture {
    display: contents;
  }

  .pk-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* ——— Freigestellt: das Produkt steht auf der Seite, ohne Rahmen ——— */
  .pk-hero__glow,
  .pk-hero__shadow {
    display: none;
  }

  .pk-hero--cutout .pk-hero__frame {
    aspect-ratio: auto;
    overflow: visible;
    border-radius: 0;
    background: none;
    isolation: isolate;
  }

  .pk-hero--cutout .pk-hero__img {
    position: relative;
    z-index: 1;
    height: auto;
    object-fit: contain;
  }

  .pk-hero--cutout .pk-hero__glow {
    display: block;
    position: absolute;
    z-index: -1;
    inset: -8% -10% -4%;
    background: radial-gradient(closest-side, var(--pk-grey) 0%, rgba(232, 232, 230, 0.55) 55%, rgba(232, 232, 230, 0) 100%);
  }

  .pk-hero--cutout .pk-hero__shadow {
    display: block;
    position: absolute;
    z-index: 0;
    left: 8%;
    right: 6%;
    bottom: -2%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(25, 25, 23, 0.28), rgba(25, 25, 23, 0));
    filter: blur(6px);
  }


  /*
   * Bewegung (reines CSS, kein Aufblitzen): Text steigt gestaffelt auf, das Bild stellt sich
   * ruhig scharf, am Desktop leichte Tiefe beim Scrollen. Kaufbereich bleibt immer sofort sichtbar.
   */
  @media (prefers-reduced-motion: no-preference) {
    .pk-hero__rise {
      animation: pk-hero-rise 0.8s var(--pk-ease) both;
      animation-delay: calc(var(--i, 0) * 90ms);
    }

    @keyframes pk-hero-rise {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
    }

    .pk-hero__img {
      animation: pk-hero-settle 1.1s var(--pk-ease) both;
    }

    @keyframes pk-hero-settle {
      from {
        opacity: 0;
        transform: scale(1.06);
      }
    }


    .pk-hero--cutout .pk-hero__img {
      animation-name: pk-hero-land;
    }

    .pk-hero--cutout .pk-hero__shadow {
      animation: pk-hero-shadow 1.1s var(--pk-ease) both;
    }

    @keyframes pk-hero-land {
      from {
        opacity: 0;
        transform: translateY(-28px);
      }
    }

    @keyframes pk-hero-shadow {
      from {
        opacity: 0;
        transform: scaleX(0.6);
      }
    }

    @supports (animation-timeline: view()) {
      @media screen and (min-width: 990px) {
        .pk-hero__img {
          animation-name: pk-hero-settle, pk-hero-drift;
          animation-duration: 1.1s, auto;
          animation-timing-function: var(--pk-ease), linear;
          animation-fill-mode: both, both;
          animation-timeline: auto, view();
          animation-range: normal, exit 0% exit 100%;
        }

        .pk-hero--cutout .pk-hero__img {
          animation: pk-hero-land 1.1s var(--pk-ease) both;
        }

        .pk-hero--cutout .pk-hero__media {
          animation: pk-hero-drift-soft linear both;
          animation-timeline: view();
          animation-range: exit 0% exit 100%;
        }

        @keyframes pk-hero-drift-soft {
          to {
            transform: translateY(8%);
          }
        }

        @keyframes pk-hero-drift {
          to {
            transform: translateY(6%) scale(1.04);
          }
        }
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PK Hero",
  "tag": "section",
  "class": "pk-section pk-section--hero",
  "settings": [
    {
      "type": "header",
      "content": "Produkt"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produkt",
      "info": "Preis und Button-Ziel kommen aus diesem Produkt. Ohne eigenes Bild wird sein Hauptbild gezeigt."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Preis anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Überzeile",
      "default": "PUREKICKZ ONE"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "info": "Kursiv gesetzter Text erscheint in Magenta.",
      "default": "Du führst. Der Rest <em>dreht sich.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Kurztext",
      "default": "<p>Der elektrische Sneaker Cleaner mit Motor und drei Aufsätzen. Du setzt ihn auf, die Bewegung macht das Gerät.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Haupt-Button",
      "default": "Jetzt kaufen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Haupt-Button Link",
      "info": "Leer lassen: führt zum gewählten Produkt."
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Zweiter Button",
      "default": "So funktioniert's"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Zweiter Button Link"
    },
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Bild Desktop (3:2)",
      "info": "Freigestellt: sneaker-cleaner-mit-sneakern.webp. Im Rahmen: hero-desktop.jpg"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Bild Handy (3:4)",
      "info": "Empfohlen: hero-mobil.jpg. Leer lassen: Desktop-Bild wird zugeschnitten."
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Bild-Stil",
      "options": [
        { "value": "cutout", "label": "Freigestellt (PNG/WebP mit Transparenz)" },
        { "value": "framed", "label": "Foto im Rahmen" }
      ],
      "default": "cutout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Bild-Position (Desktop)",
      "options": [
        { "value": "right", "label": "Rechts" },
        { "value": "left", "label": "Links" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Abstand & Farbe"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrund",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "PK Hero"
    }
  ]
}
{% endschema %}
