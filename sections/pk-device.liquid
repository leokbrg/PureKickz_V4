{%- comment -%}
  PUREKICKZ Das Gerät: schwarze Bühne mit großem Foto links und Faktenraster (2×2, feine Linien).
  „Bühne“: freigestelltes Foto steht direkt auf der Fläche, mit weichem Schein dahinter;
  unten abgeschnittene Motive (Hand) wachsen aus der unteren Section-Kante – kein Bildkasten.
  Reine Zahlen zählen beim Erscheinen hoch. Nur echte Werte eintragen.
{%- endcomment -%}

<div
  class="pk-sec pk-sec--{{ section.settings.surface }} pk-sec--edge-{{ section.settings.edge | default: 'hard' }} pk-device pk-device--{{ section.settings.image_layout | default: 'card' }}"
  style="--pk-pad-top: {{ section.settings.padding_top }}px; --pk-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="pk-sec__inner pk-device__inner">
    <div class="pk-device__visual" data-pk-reveal>
      {%- if section.settings.image_layout == 'stage' -%}
        <span class="pk-device__glow" aria-hidden="true"></span>
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '320, 440, 640, 880, 1200',
            sizes: '(min-width: 990px) 40vw, 90vw',
            loading: 'lazy',
            class: 'pk-device__img'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'pk-device__img pk-device__img--placeholder' }}
      {%- endif -%}
    </div>

    <div class="pk-device__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pk-device__eyebrow" data-pk-reveal>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pk-h2 pk-device__heading" data-pk-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="pk-lead pk-device__lead" data-pk-reveal>{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="pk-device__facts" data-pk-stagger>
          {%- for block in section.blocks -%}
{%- liquid
  if block.settings.value == blank
    continue
  endif
  assign ph = false
  if block.settings.value contains '[[' or block.settings.label contains '[['
    assign ph = true
  endif
  if ph and request.design_mode == false
    continue
  endif
-%}
            {%- liquid
              assign value = block.settings.value | strip
              assign number = value | plus: 0
              assign number_text = number | append: ''
            -%}
            <li class="pk-device__fact{% if ph %} pk-ph{% endif %}" data-pk-reveal {{ block.shopify_attributes }}>
              {%- if number_text == value and number > 0 -%}
                <b data-pk-count="{{ number }}">{{ value }}</b>
              {%- else -%}
                <b>{{ value }}</b>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span>{{ block.settings.label }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pk-device__inner {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  .pk-device__visual {
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 4 / 5;
    background: var(--pk-s-card);
  }

  .pk-device__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pk-device__img--placeholder {
    fill: var(--pk-muted);
    opacity: 0.4;
  }

  .pk-device__eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-subheading--family);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--pk-s-soft);
  }

  .pk-device__heading {
    max-width: 16ch;
  }

  .pk-device__lead {
    margin-top: 18px;
  }

  /* Faktenraster: Zellen auf der Fläche, Linien entstehen aus dem 1-px-Abstand */
  .pk-device__facts {
    list-style: none;
    margin: clamp(24px, 3vw, 36px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--pk-s-line);
    border: 1px solid var(--pk-s-line);
  }

  .pk-device__fact {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(18px, 2.4vw, 28px) clamp(16px, 2vw, 24px);
    background: var(--pk-s-bg);
  }

  .pk-device__fact b {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .pk-device__fact span {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--pk-s-soft);
  }

  @media screen and (min-width: 990px) {
    .pk-device__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .pk-device__visual {
      aspect-ratio: 2 / 3;
      max-height: 640px;
    }
  }

  /* Bühne: freigestelltes Gerät auf der Fläche. Am Handy unter den Fakten, am Desktop links;
     die untere Bildkante sitzt immer auf der Section-Kante. */
  .pk-device--stage {
    overflow: clip;
  }

  .pk-device--stage .pk-device__visual {
    position: relative;
    order: 2;
    justify-self: center;
    width: min(72%, 320px);
    margin-top: 8px;
    margin-bottom: calc(var(--pk-pad-bottom, 112px) * -0.6);
    aspect-ratio: auto;
    overflow: visible;
    border-radius: 0;
    background: none;
  }

  .pk-device--stage .pk-device__img {
    position: relative;
    transform-origin: 50% 100%;
    height: auto;
    object-fit: contain;
  }

  .pk-device__glow {
    position: absolute;
    inset: 0 -30% 10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(180, 41, 152, 0.28), rgba(180, 41, 152, 0.06) 60%, transparent);
    filter: blur(12px);
  }

  @media screen and (min-width: 990px) {
    .pk-device--stage .pk-device__inner {
      align-items: center;
    }

    .pk-device--stage .pk-device__visual {
      order: 0;
      align-self: end;
      width: min(100%, 440px);
      max-height: none;
      margin-top: 0;
      margin-bottom: calc(var(--pk-pad-bottom, 112px) * -1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pk-motion .pk-device__visual .pk-device__img {
      transform: scale(1.06);
      transition: transform 1.4s var(--pk-ease);
    }

    .pk-motion .pk-device__visual.is-visible .pk-device__img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PK Das Gerät",
  "tag": "section",
  "class": "pk-section pk-section--device",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Fläche",
      "info": "Immer abwechselnd zur Section davor und danach wählen.",
      "options": [
        { "value": "white", "label": "Weiß" },
        { "value": "grey", "label": "Hellgrau" },
        { "value": "dark", "label": "Schwarz" }
      ],
      "default": "dark"
    },
    {
      "type": "select",
      "id": "edge",
      "label": "Form der Fläche",
      "info": "Hart: gerade Kante über die ganze Breite. Box: abgerundete Fläche mit Abstand zum Rand.",
      "options": [
        { "value": "hard", "label": "Hart" },
        { "value": "panel", "label": "Box mit runden Ecken" }
      ],
      "default": "hard"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild (Hochformat)"
    },
    {
      "type": "select",
      "id": "image_layout",
      "label": "Bild-Inszenierung",
      "info": "Bühne: freigestelltes Bild (PNG/WebP) steht direkt auf der Fläche, die Unterkante sitzt auf der Section-Kante – ideal für Hand-Fotos. Karte: Foto mit eigenem Hintergrund im Rahmen.",
      "options": [
        { "value": "stage", "label": "Freigestellt auf der Bühne" },
        { "value": "card", "label": "Bild als Karte" }
      ],
      "default": "stage"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Überzeile",
      "default": "Das Gerät"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Gebaut, um die Arbeit zu machen."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Ein Motor, ein Knopf, drei Aufsätze.</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 32,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 32,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fakt",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Wert",
          "info": "Reine Zahl (z. B. 1200) zählt beim Erscheinen hoch. Nur echte Werte.",
          "default": "1200"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Beschreibung",
          "default": "mAh Akku"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PK Das Gerät",
      "blocks": [
        { "type": "fact", "settings": { "value": "1200", "label": "mAh Akku" } },
        { "type": "fact", "settings": { "value": "3", "label": "Aufsätze im Lieferumfang" } },
        { "type": "fact", "settings": { "value": "163", "label": "mm lang (163 × 96 × 45)" } },
        { "type": "fact", "settings": { "value": "USB-C", "label": "Laden über Standardkabel" } }
      ]
    }
  ]
}
{% endschema %}
