{%- doc -%}
  Schlichte Linien-Icons für PUREKICKZ-Sections (24×24, Strichstärke über CSS).

  @param {string} name - truck, return, lock, clock, mail, box, check, battery, plug, card
  @param {string} [class] - zusätzliche Klasse
{%- enddoc -%}
<svg
  class="pk-icon pk-icon--{{ name }} {{ class }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9.5H3z"/><path d="M14 10h4l3 3.2V16h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
    {%- when 'return' -%}
      <path d="M3.5 12a8.5 8.5 0 1 1 2.6 6.1"/><path d="M3.5 19.5v-5h5"/>
    {%- when 'lock' -%}
      <rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path class="pk-icon__shackle" d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path class="pk-icon__hand" d="M12 7.5V12l3 2"/>
    {%- when 'mail' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>
    {%- when 'box' -%}
      <path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>
    {%- when 'battery' -%}
      <rect x="2.5" y="7.5" width="16" height="9" rx="2"/><path d="M21.5 10.5v3"/><path d="M5.5 10.5v3M8.5 10.5v3M11.5 10.5v3"/>
    {%- when 'plug' -%}
      <path d="M9 3v4M15 3v4"/><path d="M6.5 7h11v3a5.5 5.5 0 0 1-11 0z"/><path d="M12 15.5V21"/>
    {%- when 'card' -%}
      <rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 10h19M6 15h4"/>
    {%- else -%}
      <path d="M4.5 12.5 9.5 17.5 19.5 6.5"/>
  {%- endcase -%}
</svg>
