 {"type": "spec", "settings": {"label": "Aufsätze", "value": "3"}}, "d5": {"type": "spec", "settings": {"label": "Akkulaufzeit", "value": "[[AKKULAUFZEIT]]"}}, "d6": {"type": "spec", "settings": {"label": "Ladedauer", "value": "[[LADEDAUER]]"}}}, "block_order": ["i1", "i2", "i3", "i4", "i5", "d1", "d2", "d3", "d4", "d5", "d6"]}, "pk_reviews": {"type": "pk-reviews", "disabled": true, "settings": {"enabled": false, "surface": "white", "eyebrow": "Bewertungen", "heading": "Echte <em>Stimmen.</em>", "padding_top": 112, "padding_bottom": 112}}, "pk_about": {"type": "pk-about", "settings": {"surface": "white", "image": "shopify://shop_images/kachel-sneaker-cleaner.jpg", "eyebrow": "Über PUREKICKZ", "heading": "Schuhpflege, <em>einfacher gemacht.</em>", "text": "<p>PUREKICKZ ist eine junge Marke aus Deutschland. Wir wollen Schuhpflege einfacher machen – mit Werkzeug, das die Arbeit übernimmt, und Angaben, die stimmen.</p><p>Der PUREKICKZ ONE ist unser erstes Produkt. Weitere Pflegeprodukte sind in Planung.</p>", "signature": "Dein PUREKICKZ-Team", "button_label": "", "button_link": "", "padding_top": 112, "padding_bottom": 112}}, "pk_faq": {"type": "pk-faq", "settings": {"surface": "grey", "eyebrow": "FAQ", "heading": "Fragen? <em>Antworten.</em>", "show_service": true, "service_title": "Noch Fragen?", "service_text": "<p>Schreib uns – wir helfen dir gern weiter.</p>", "email": "info@purekickz.de", "response_time": "Antwort: [[ANTWORTZEIT]]", "link_label": "Alle Fragen ansehen", "link": "/pages/faq", "padding_top": 112, "padding_bottom": 112}, "blocks": {"q1": {"type": "question", "settings": {"question": "Welche Aufsätze sind dabei?", "answer": "<p>Drei: eine harte Bürste für Sohle und Sohlenrand, eine weiche Bürste für Obermaterial wie Leder und Mesh und ein Schwamm zum Auftragen von Reinigungsmittel und zum Abwischen.</p>"}}, "q2": {"type": "question", "settings": {"question": "Wie funktioniert der PUREKICKZ ONE?", "answer": "<p>Aufsatz wählen, aufsetzen, einschalten und das Gerät über die verschmutzte Fläche führen. Der Motor dreht den Aufsatz – du musst nicht selbst schrubben.</p>"}}, "q3": {"type": "question", "settings": {"question": "Wie lade ich das Gerät?", "answer": "<p>Über den USB-C-Anschluss. Ladedauer: [[LADEDAUER]].</p>"}}, "q4": {"type": "question", "settings": {"question": "Wie lange hält der Akku?", "answer": "<p>Der Akku hat 1200 mAh. Laufzeit pro Ladung: [[AKKULAUFZEIT]].</p>"}}, "q5": {"type": "question", "settings": {"question": "Ist ein USB-C-Kabel dabei?", "answer": "<p>[[KABEL_IM_LIEFERUMFANG]]</p>"}}, "q6": {"type": "question", "settings": {"question": "Wie schnell ist meine Bestellung da?", "answer": "<p>Wir versenden aus Deutschland, meist innerhalb von 1 Werktag. Innerhalb Deutschlands dauert die Lieferung danach 2–4 Werktage.</p>"}}, "q7": {"type": "question", "settings": {"question": "Kann ich den PUREKICKZ ONE zurückgeben?", "answer": "<p>Ja, du hast 14 Tage Widerrufsrecht. Die Rücksendung ist für dich kostenlos. Alle Details findest du in der <a href=\"/policies/refund-policy\">Widerrufsbelehrung</a>.</p>"}}, "q8": {"type": "question", "settings": {"question": "Wie kann ich bezahlen?", "answer": "<p>Du bezahlst sicher über den Shopify-Checkout. Welche Zahlungsarten du nutzen kannst, siehst du im Checkout und auf der Seite <a href=\"/pages/zahlungsarten\">Zahlungsarten</a>.</p>"}}, "q9": {"type": "question", "settings": {"question": "Gibt es eine Garantie?", "answer": "<p>[[GARANTIE]]</p>"}}}, "block_order": ["q1", "q2", "q3", "q4", "q5", "q6", "q7", "q8", "q9"]}, "pk_before_after": {"type": "pk-before-after", "disabled": true, "settings": {"surface": "white", "eyebrow": "Vorher / Nachher", "heading": "Sieh selbst.", "label_before": "Vorher", "label_after": "Nachher", "padding_top": 112, "padding_bottom": 112}}, "pk_cta": {"type": "pk-buy-cta", "settings": {"surface": "dark", "product": "purekickz-one-elektrischer-sneaker-cleaner", "image": "shopify://shop_images/sneaker-cleaner-mit-sneakern.webp", "e