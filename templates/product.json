        "q2": {
          "type": "question",
          "settings": {
            "question": "Wie funktioniert der PUREKICKZ ONE?",
            "answer": "<p>Aufsatz wählen, aufsetzen, einschalten und das Gerät über die verschmutzte Fläche führen. Der Motor dreht den Aufsatz – du musst nicht selbst schrubben.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Wie lade ich das Gerät?",
            "answer": "<p>Über den USB-C-Anschluss. Ladedauer: [[LADEDAUER]].</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Wie lange hält der Akku?",
            "answer": "<p>Der Akku hat 1200 mAh. Laufzeit pro Ladung: [[AKKULAUFZEIT]].</p>"
